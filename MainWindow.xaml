<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PostInstallKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PostInstallKit"
    Title="PostInstallKit">

    <Grid RequestedTheme="Dark" Padding="20,0,20,16" RowSpacing="12">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#05080D" Offset="0"/>
                <GradientStop Color="#0B1422" Offset="0.6"/>
                <GradientStop Color="#071018" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Resources>
            <!-- Accent colour overrides (cyan) -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#22D3EE"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#67E8F9"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#06B6D4"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#1B2A3D"/>
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#04121A"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#04121A"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#04121A"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#7DE9F9"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#A5F3FC"/>

            <!-- Normal buttons: subtle glass look with a cyan edge on hover -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#10FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#8022D3EE"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#6022D3EE"/>

            <!-- Checkboxes -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#22D3EE"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#67E8F9"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#06B6D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#22D3EE"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#67E8F9"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#06B6D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#04121A"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#04121A"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#04121A"/>

            <!-- Card: dark panel with a cyan-to-dark gradient edge -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#F00E1621"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6622D3EE" Offset="0"/>
                            <GradientStop Color="#1B2A3D" Offset="0.45"/>
                            <GradientStop Color="#1B2A3D" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.65"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="CharacterSpacing" Value="150"/>
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                <Setter Property="Foreground" Value="#22D3EE"/>
                <Setter Property="Opacity" Value="0.85"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
            </Style>

            <!-- App / runtime row -->
            <DataTemplate x:Key="AppTemplate" x:DataType="local:AppItem">
                <Grid ColumnSpacing="12" Padding="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
                    <Border Grid.Column="1" CornerRadius="10" Padding="10,2" MinWidth="70" Background="#14FFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Category}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBrush, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Activation tool row -->
            <DataTemplate x:Key="ToolTemplate" x:DataType="local:ToolItem">
                <Grid ColumnSpacing="12" Padding="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Launch" Tag="{x:Bind Path}" Click="LaunchTool_Click"/>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- title bar -->
            <RowDefinition Height="Auto"/>
            <!-- glow line -->
            <RowDefinition Height="Auto"/>
            <!-- toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- progress -->
            <RowDefinition Height="*"/>
            <!-- tabs + pages -->
            <RowDefinition Height="Auto"/>
            <!-- log -->
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="46" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#67E8F9" Offset="0"/>
                        <GradientStop Color="#0891B2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock Grid.Column="1" Text="POSTINSTALLKIT" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" CharacterSpacing="200" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="fresh-install toolkit" Opacity="0.45" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- Glow line under the title bar -->
        <Rectangle Grid.Row="1" Height="2" RadiusX="1" RadiusY="1">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF22D3EE" Offset="0"/>
                    <GradientStop Color="#6622D3EE" Offset="0.35"/>
                    <GradientStop Color="#0022D3EE" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Toolbar: scan / retry on the left, profiles on the right -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10">
            <Grid x:Name="TopBar" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Scan installed" Click="Scan_Click"/>
                    <CheckBox x:Name="SkipInstalledCheck" Content="Skip already installed" IsChecked="True" Margin="8,0,0,0"/>
                    <Button x:Name="RetryButton" Content="Retry failed" IsEnabled="False" Click="RetryButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="PROFILE" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ProfileCombo" Width="200" ItemsSource="{x:Bind Profiles}" PlaceholderText="No profile selected"/>
                    <Button Content="Load" Click="LoadProfile_Click"/>
                    <Button Content="Save as..." Click="SaveProfile_Click"/>
                    <Button Content="Delete" Click="DeleteProfile_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar x:Name="Progress" Grid.Row="3" Minimum="0" Maximum="1" Value="0" Foreground="#22D3EE" Background="#1B2A3D"/>

        <!-- Top tabs + pages -->
        <NavigationView x:Name="NavView" Grid.Row="4"
                        PaneDisplayMode="Top"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False"
                        Background="Transparent"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#22D3EE"/>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="1. Updates" Tag="updates"/>
                <NavigationViewItem Content="2. Runtimes" Tag="runtimes"/>
                <NavigationViewItem Content="3. Settings" Tag="settings"/>
                <NavigationViewItem Content="4. Debloat" Tag="debloat"/>
                <NavigationViewItem Content="5. Activate" Tag="activate"/>
                <NavigationViewItem Content="6. Apps" Tag="apps"/>
                <NavigationViewItem Content="7. Drivers" Tag="drivers"/>
            </NavigationView.MenuItems>

            <Grid x:Name="PagesHost">

                <!-- 1. Updates -->
                <Grid Tag="updates" Visibility="Collapsed" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Windows Update" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Installs Windows updates, including optional ones. After a restart, run it again until nothing new is found."/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Run Windows Update" Style="{StaticResource AccentButtonStyle}" Click="WindowsUpdate_Click"/>
                                <Button Content="Open Windows Update settings" Click="OpenWuSettings_Click"/>
                                <Button Content="Restart PC" Click="Restart_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Runtimes -->
                <Grid Tag="runtimes" Visibility="Collapsed" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Runtimes" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Select all" Tag="runtimes" Click="SelectAll_Click"/>
                                    <Button Content="Select none" Tag="runtimes" Click="SelectNone_Click"/>
                                    <Button Content="Install selected" Tag="runtimes" Style="{StaticResource AccentButtonStyle}" Click="InstallGroup_Click"/>
                                </StackPanel>
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind RuntimeApps}" ItemTemplate="{StaticResource AppTemplate}" SelectionMode="None"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Settings -->
                <Grid Tag="settings" Visibility="Collapsed" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Windows settings" Style="{StaticResource CardTitle}"/>

                            <TextBlock Text="POWER" Style="{StaticResource SectionLabel}"/>
                            <CheckBox x:Name="PowerPlanCheck" Content="Power plan: Ultimate Performance (falls back to High Performance)" IsChecked="True"/>
                            <CheckBox x:Name="NeverSleepCheck" Content="Never turn off screen / sleep / hibernate when plugged in" IsChecked="True"/>

                            <TextBlock Text="EXPLORER" Style="{StaticResource SectionLabel}"/>
                            <CheckBox x:Name="FileExtCheck" Content="Show file extensions" IsChecked="True"/>
                            <CheckBox x:Name="HiddenFilesCheck" Content="Show hidden files and folders" IsChecked="True"/>
                            <CheckBox x:Name="ThisPcCheck" Content="Show 'This PC' icon on the desktop" IsChecked="True"/>

                            <TextBlock Text="WINDOWS FEATURES" Style="{StaticResource SectionLabel}"/>
                            <CheckBox x:Name="NetFx3Check" Content="Enable .NET Framework 3.5 (needs internet)" IsChecked="True"/>

                            <Button Content="Apply selected" Style="{StaticResource AccentButtonStyle}" Click="ApplyTweaks_Click" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. Debloat -->
                <Grid Tag="debloat" Visibility="Collapsed" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Debloat and tweak" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Chris Titus Tech tool (WinUtil). Use your saved config so your usual tweaks are loaded for you."/>
                            <TextBlock x:Name="TitusConfigStatus" Style="{StaticResource Muted}" Opacity="0.9"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Launch with my config" Style="{StaticResource AccentButtonStyle}" Click="TitusConfig_Click"/>
                                <Button Content="Launch and run my config automatically" Click="TitusConfigRun_Click"/>
                                <Button Content="Launch (no config)" Click="Titus_Click"/>
                                <Button Content="Open config folder" Click="OpenTitusFolder_Click"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Opacity="0.5" Text="To make a config: open the tool, tick your tweaks, click the gear icon (top right), choose Export, and save it as config.json in the Tools\Titus folder."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 5. Activate -->
                <Grid Tag="activate" Visibility="Collapsed" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="10">
                                <TextBlock Text="Activation" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Shows every .cmd, .bat or .exe file found in the Tools\Activation folder next to the app."/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Refresh list" Click="RefreshTools_Click"/>
                                    <Button Content="Open Tools folder" Click="OpenToolsFolder_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ActivationTools}" ItemTemplate="{StaticResource ToolTemplate}" SelectionMode="None"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 6. Apps -->
                <Grid Tag="apps" Visibility="Collapsed" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Apps" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Select all" Tag="apps" Click="SelectAll_Click"/>
                                    <Button Content="Select none" Tag="apps" Click="SelectNone_Click"/>
                                    <Button Content="Install selected" Tag="apps" Style="{StaticResource AccentButtonStyle}" Click="InstallGroup_Click"/>
                                </StackPanel>
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind CommonApps}" ItemTemplate="{StaticResource AppTemplate}" SelectionMode="None"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 7. Drivers -->
                <Grid Tag="drivers" Visibility="Collapsed" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Text="Drivers" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Click your brand to open its official driver page in your browser, then search for your exact model and download the driver yourself."/>
                                <Button Content="Open Windows Update settings (drivers often appear under Optional updates)" Click="OpenWuSettings_Click"/>

                                <TextBlock Text="GRAPHICS, CPU AND CHIPSET" Style="{StaticResource SectionLabel}"/>
                                <GridView SelectionMode="None">
                                    <Button Content="NVIDIA" MinWidth="120" Tag="https://www.nvidia.com/Download/index.aspx" Click="OpenLink_Click"/>
                                    <Button Content="AMD" MinWidth="120" Tag="https://www.amd.com/en/support/download/drivers.html" Click="OpenLink_Click"/>
                                    <Button Content="Intel" MinWidth="120" Tag="https://www.intel.com/content/www/us/en/download-center/home.html" Click="OpenLink_Click"/>
                                </GridView>

                                <TextBlock Text="MOTHERBOARD, AUDIO AND NETWORK" Style="{StaticResource SectionLabel}"/>
                                <GridView SelectionMode="None">
                                    <Button Content="ASUS" MinWidth="120" Tag="https://www.asus.com/support/download-center/" Click="OpenLink_Click"/>
                                    <Button Content="MSI" MinWidth="120" Tag="https://www.msi.com/support/download/" Click="OpenLink_Click"/>
                                    <Button Content="Gigabyte" MinWidth="120" Tag="https://www.gigabyte.com/Support/Consumer/Download" Click="OpenLink_Click"/>
                                    <Button Content="ASRock" MinWidth="120" Tag="https://www.asrock.com/support/index.asp" Click="OpenLink_Click"/>
                                    <Button Content="Realtek" MinWidth="120" Tag="https://www.realtek.com/Download" Click="OpenLink_Click"/>
                                </GridView>

                                <TextBlock Text="LAPTOPS AND PREBUILT PCS" Style="{StaticResource SectionLabel}"/>
                                <GridView SelectionMode="None">
                                    <Button Content="Dell" MinWidth="120" Tag="https://www.dell.com/support/home/" Click="OpenLink_Click"/>
                                    <Button Content="HP" MinWidth="120" Tag="https://support.hp.com/drivers" Click="OpenLink_Click"/>
                                    <Button Content="Lenovo" MinWidth="120" Tag="https://support.lenovo.com/" Click="OpenLink_Click"/>
                                    <Button Content="Acer" MinWidth="120" Tag="https://www.acer.com/support" Click="OpenLink_Click"/>
                                </GridView>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>
        </NavigationView>

        <!-- Collapsible log -->
        <Expander x:Name="LogExpander" Grid.Row="5"
                  ExpandDirection="Up"
                  IsExpanded="False"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Background="#F00A1019"
                  BorderBrush="#1B2A3D"
                  CornerRadius="10">
            <Expander.Header>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LOG" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" CharacterSpacing="200" Foreground="#22D3EE" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LogLastLine" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"/>
                </Grid>
            </Expander.Header>

            <ScrollViewer x:Name="LogScroll" Height="220">
                <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Expander>
    </Grid>
</Window>